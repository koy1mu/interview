{
	"name": "task-manager-interview",
	"version": "1.0.0",
	"description": "Task Manager - Interview Project",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "tsx src/index.ts",
		"start:local": "docker compose up -d && tsx watch src/index.ts",
		"dev": "tsx watch src/index.dev.ts",
		"build": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:unit": "vitest run src/",
		"test:db": "vitest run tests/db/",
		"test:integration": "vitest run tests/integration/",
		"lint": "eslint src/ tests/"
	},
	"dependencies": {
		"dotenv": "^16.4.5",
		"express": "^4.21.0",
		"inversify": "^6.2.1",
		"mongodb": "^6.9.0",
		"neverthrow": "^8.1.1",
		"pino": "^9.5.0",
		"reflect-metadata": "^0.2.2",
		"swagger-ui-express": "^5.0.1",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@swc/core": "^1.7.0",
		"@types/express": "^5.0.0",
		"@types/node": "^22.0.0",
		"@types/swagger-ui-express": "^4.1.8",
		"eslint": "^9.0.0",
		"mongodb-memory-server-core": "^10.1.2",
		"tsx": "^4.19.0",
		"typescript": "^5.6.0",
		"typescript-eslint": "^8.0.0",
		"unplugin-swc": "^1.5.0",
		"vitest": "^2.1.0"
	}
}
